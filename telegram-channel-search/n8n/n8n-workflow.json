{
  "name": "Telegram posts by keyword every day",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "id": "1",
      "name": "Every day",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/avakode~telegram-channel-search/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"channels\": [\"telegram\", \"durov\"], \"keywords\": [\"privacy\"], \"maxAgeDays\": 0, \"maxPostsPerChannel\": 20, \"onlyNew\": false, \"maxResults\": 40, \"excludeKeywords\": []}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "2",
      "name": "Run the Actor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "channel",
              "value": "={{ $json.channel }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "posted_at",
              "value": "={{ $json.posted_at }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "matched_keyword",
              "value": "={{ $json.matched_keyword }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "views",
              "value": "={{ $json.views }}",
              "type": "number"
            },
            {
              "id": "a5",
              "name": "url",
              "value": "={{ $json.url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "3",
      "name": "Keep main fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Every day": {
      "main": [
        [
          {
            "node": "Run the Actor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run the Actor": {
      "main": [
        [
          {
            "node": "Keep main fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
